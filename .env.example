# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# Telegram ID админов через запятую — им доступна /admin
ADMIN_IDS=

# Сайт с «Экспресс-расписанием» и как часто его проверять (секунды)
BASE_URL=https://vgek43.ru/
UPDATE_INTERVAL=1800
TIMEZONE=Europe/Moscow

# База и файлы
DB_PATH=schedule.db
DATA_DIR=data
BACKUP_DIR=backups
BACKUP_KEEP=7
BACKUP_TIME=03:00

# Через сколько неудачных проверок сайта писать админу; дней Premium за приглашённого друга
ALERT_AFTER=3
REF_BONUS_DAYS=7

# 💳 Оплата картой и СБП через ЮKassa: токен из @BotFather → бот → Payments → ЮKassa.
# Пусто — оплата только звёздами. Для проверки подойдёт тестовый токен (…:TEST:…).
YOOKASSA_PROVIDER_TOKEN=
# 1 — передавать данные чека (ИП/ООО с онлайн-кассой ЮKassa); самозанятым с «Чеками от ЮKassa» — 0
YOOKASSA_RECEIPT=0
# Ставка НДС в чеке: 1 — без НДС
YOOKASSA_VAT_CODE=1

# 📲 Виджет на экран телефона: внешний адрес и порт веб-сервера картинок (0 — выключен)
PUBLIC_URL=
WEB_PORT=0
